# Credenciais da sua aplicação no painel de desenvolvedores do Mercado Livre
# (https://developers.mercadolivre.com.br) — Minhas aplicações > sua app.
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=

# Deve ser IDÊNTICA (protocolo, domínio e path) à Redirect URI cadastrada no
# painel do Mercado Livre.
# Produção (Netlify):  https://MEU-SITE.netlify.app/api/auth/mercadolivre/callback
# Local (dev):         http://localhost:3000/api/auth/mercadolivre/callback
MELI_REDIRECT_URI=

# Lista de IDs de anúncios do Mercado Livre a exibir no catálogo, separados
# por vírgula (ex.: MLB1234567890,MLB9876543210). Pegue o ID na URL do
# próprio anúncio no site do Mercado Livre.
MELI_ITEM_IDS=
